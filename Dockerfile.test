# Dockerfile for running tests in a containerized environment
# Based on node:20-alpine for Node.js unit tests
FROM node:20-alpine

# Install build dependencies for native modules
RUN apk add --no-cache python3 make g++

WORKDIR /work

# Give the app user a writable home
ENV HOME=/tmp
ENV npm_config_cache=/tmp/.npm

# Non-root user for safety
USER node

CMD ["sh"]
