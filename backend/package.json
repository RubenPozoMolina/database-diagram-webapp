{
  "name": "database-diagram-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lightweight backend for PostgreSQL communication (test connection, read schema, apply schema)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
